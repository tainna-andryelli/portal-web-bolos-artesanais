# Banco de dados PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/bolos_artesanais"

# Segredo para assinar os tokens JWT
# Gere um valor seguro rodando no terminal:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-de-64-caracteres-gerado-com-o-comando-acima"

# Ambiente (development | production)
NODE_ENV="development"

# Porta do servidor (opcional, padrão: 3333)
PORT=3333

# Origem permitida pelo CORS (URL do frontend)
CORS_ORIGIN="http://localhost:5173"